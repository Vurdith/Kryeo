{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryeo Next",
  "version": "0.1.0",
  "identifier": "com.kryeo.desktop.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Kryeo", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 700 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../build-icon.ico"]
  }
}
