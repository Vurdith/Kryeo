KRYEO_AI_HOST=127.0.0.1
KRYEO_AI_PORT=8787
KRYEO_AI_TOKENS=replace-with-a-long-random-token
# Hosted default. Keep the OpenRouter key only in the server's ignored .env or a secret manager.
KRYEO_AI_MODEL=qwen/qwen3.7-flash
KRYEO_AI_MODEL_LITE=qwen/qwen3.7-flash
KRYEO_AI_MODEL_ESCALATION=qwen/qwen3.7-flash
KRYEO_MODEL_BASE_URL=https://openrouter.ai/api/v1
KRYEO_MODEL_API_KEY=
KRYEO_AI_DATA_DIR=.data
# Bound the structured-result cache so a long-running shared gateway cannot grow without limit.
KRYEO_AI_MAX_CACHE_ENTRIES=20000
KRYEO_AI_MAX_QUEUE=100
# Match this to the model server's safe parallel-request capacity.
KRYEO_AI_MODEL_CONCURRENCY=2
KRYEO_AI_MAX_INFLIGHT_PER_TOKEN=2
KRYEO_AI_FAMILY_BATCH_SIZE=16
# Send at most two representative member previews per family to control vision-token cost.
KRYEO_AI_MAX_MEMBER_IMAGES_PER_FAMILY=2
# Free desktop preprocessing groups and deduplicates; the cloud model still classifies every unresolved family.
KRYEO_AI_SCAN_TARGET_USD=0.01
KRYEO_AI_SCAN_BUDGET_USD=0.03
KRYEO_AI_ENFORCE_SCAN_BUDGET=true
KRYEO_AI_MAX_HOSTED_FAMILIES_PER_SCAN=0
KRYEO_AI_MAX_ESCALATION_FAMILIES_PER_SCAN=1
KRYEO_AI_ESTIMATED_INPUT_TOKENS_PER_IMAGE=300
KRYEO_AI_ESTIMATED_TEXT_TOKENS_PER_FAMILY=260
KRYEO_AI_ESTIMATED_OUTPUT_TOKENS_PER_FAMILY=40
KRYEO_AI_LITE_INPUT_PRICE_PER_MILLION=0.03
KRYEO_AI_LITE_OUTPUT_PRICE_PER_MILLION=0.13
KRYEO_AI_ESCALATION_INPUT_PRICE_PER_MILLION=0.03
KRYEO_AI_ESCALATION_OUTPUT_PRICE_PER_MILLION=0.13
KRYEO_AI_COST_ESTIMATE_SAFETY_FACTOR=2
KRYEO_AI_MAX_MODEL_RETRIES=1
KRYEO_AI_REASONING_EFFORT=none
KRYEO_AI_PROVIDER_SORT=price
# Use the normal low-cost OpenRouter lane.
KRYEO_AI_SERVICE_TIER=default
# Keep stable classification rules in the first cacheable message and dynamic family data last.
KRYEO_OPENROUTER_PROMPT_CACHE=true
# Optional retry/deduplication cache. Enabling it allows temporary OpenRouter response retention.
KRYEO_OPENROUTER_RESPONSE_CACHE=false
KRYEO_AI_RATE_LIMIT_PER_MINUTE=0
KRYEO_AI_MAX_BODY_MB=18
# Leave strict provider parameter matching off so OpenRouter can use compatible endpoints.
KRYEO_OPENROUTER_REQUIRE_PARAMETERS=false
